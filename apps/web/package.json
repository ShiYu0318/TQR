{
  "name": "@tqr/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TQR Studio as a web app (Vite + React + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tqr/tri-core": "^0.1.0",
    "comlink": "^4.4.2",
    "i18next": "^26.4.2",
    "manifold-3d": "^3.5.4",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "three": "^0.186.1",
    "zustand": "^5.0.15",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
